<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>外卖Demo网站</title>
    <meta name="description" content="外卖网页演示，菜品选择、购物车、模拟下单支付">
    <meta name="keywords" content="外卖demo,前端外卖页面,购物车模拟下单">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, sans-serif;
        }
        body {
            background-color: #f5f5f5;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        h1 {
            text-align: center;
            color: #ff4d4f;
            margin-bottom: 30px;
        }
        .food-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom:30px;
        }
        .food-item {
            background:#fff;
            border-radius:12px;
            padding:16px;
            box-shadow:0 2px 8px #00000010;
        }
        .food-item h3 {
            margin:8px 0;
        }
        .price {
            color:#ff4d4f;
            font-weight:bold;
            margin-bottom:10px;
        }
        .add-cart {
            width:100%;
            padding:8px;
            background:#ff4d4f;
            color:white;
            border:none;
            border-radius:6px;
            cursor:pointer;
        }
        .cart-box {
            background:white;
            border-radius:12px;
            padding:20px;
            box-shadow:0 2px 8px #00000010;
        }
        .cart-item{
            display:flex;
            justify-content:space-between;
            padding:8px 0;
            border-bottom:1px solid #eee;
        }
        .cart-item button{
            padding:2px 8px;
            margin:0 4px;
        }
        .total{
            font-size:18px;
            font-weight:bold;
            margin:16px 0;
        }
        .address-input{
            width:100%;
            padding:10px;
            border:1px solid #ddd;
            border-radius:6px;
            margin:10px 0 16px;
        }
        .submit-order{
            width:100%;
            padding:12px;
            background:#ff4d4f;
            color:white;
            border:none;
            border-radius:8px;
            font-size:16px;
            cursor:pointer;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>🍔 外卖演示小程序</h1>
    <div class="food-list" id="foodList">
        <!--菜品由JS渲染-->
    </div>

    <div class="cart-box">
        <h2>🛒 购物车</h2>
        <div id="cartList"></div>
        <div class="total">合计：¥<span id="totalPrice">0</span></div>
        <input type="text" class="address-input" id="address" placeholder="请输入收货地址">
        <button class="submit-order" onclick="submitOrder()">提交订单（模拟支付）</button>
    </div>
</div>

<script>
    // 菜品数据
    const foodData = [
        {id:1,name:"香辣鸡腿堡",price:18},
        {id:2,name:"薯条大份",price:12},
        {id:3,name:"可乐",price:5},
        {id:4,name:"奥尔良烤翅2只",price:14},
        {id:5,name:"牛肉盖饭",price:22},
        {id:6,name:"珍珠奶茶",price:9}
    ];
    let cart = [];

    //渲染菜品
    function renderFood(){
        const wrap = document.getElementById("foodList");
        wrap.innerHTML = "";
        foodData.forEach(item=>{
            wrap.innerHTML += `
                <div class="food-item">
                    <h3>${item.name}</h3>
                    <div class="price">¥${item.price}</div>
                    <button class="add-cart" onclick="addFood(${item.id})">加入购物车</button>
                </div>
            `
        })
    }

    //加入购物车
    function addFood(id){
        const food = foodData.find(i=>i.id===id);
        const exist = cart.find(i=>i.id===id);
        if(exist){
            exist.num +=1;
        }else{
            cart.push({...food,num:1});
        }
        renderCart();
    }

    //修改数量
    function changeNum(id,step){
        const item = cart.find(i=>i.id===id);
        item.num += step;
        if(item.num <=0){
            cart = cart.filter(i=>i.id !== id);
        }
        renderCart();
    }

    //渲染购物车+总价
    function renderCart(){
        const cartWrap = document.getElementById("cartList");
        let html = "";
        let total = 0;
        cart.forEach(item=>{
            html += `
                <div class="cart-item">
                    <span>${item.name} × ${item.num}</span>
                    <span>
                        <button onclick="changeNum(${item.id},-1)">-</button>
                        <button onclick="changeNum(${item.id},1)">+</button>
                    </span>
                </div>
            `
            total += item.price * item.num;
        })
        cartWrap.innerHTML = html;
        document.getElementById("totalPrice").innerText = total;
    }

    //提交订单 模拟支付
    function submitOrder(){
        const addr = document.getElementById("address").value.trim();
        if(!addr){
            alert("请填写收货地址！");
            return;
        }
        if(cart.length===0){
            alert("购物车是空的，请先点餐！");
            return;
        }
        alert(`订单提交成功！收货地址：${addr}\n【模拟支付】支付成功！`);
        cart = [];
        renderCart();
        document.getElementById("address").value="";
    }

    //初始化页面
    renderFood();
    renderCart();
</script>
</body>
</html>
